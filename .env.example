GROQ_API_KEY=your_groq_api_key_here

# Required: used both by docker compose (to create the database) and by the app (to connect).
# Pick your own value; never commit your real .env.
POSTGRES_PASSWORD=

# Hosted database (e.g. Neon): paste its connection string here and it replaces the POSTGRES_* settings.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Everything below is optional — the defaults match docker-compose.yml.
# Set REDIS_URL= or MONGO_URL= to an empty value to turn caching / logging off.
# RATE_LIMIT_PER_MINUTE=20
# GROQ_MODEL=openai/gpt-oss-120b
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=rag_db
# POSTGRES_USER=rag
# REDIS_URL=redis://localhost:6379/0
# CACHE_TTL_SECONDS=3600
# MONGO_URL=mongodb://localhost:27017/
# MONGO_DB=rag_db
# TOP_K=5
